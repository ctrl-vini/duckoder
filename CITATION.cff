    alias: ctrl-vini
license: AGPL-3.0-or-later
version: 1.4.0
date-released: '2026-10-18'
repository-code: 'https://github.com/ctrl-vini/duckoder'
url: 'https://www.duckoder.com.br'
keywords:
  - embedded systems
  - ESP32
  - Arduino
  - large language models
  - code generation
  - computing education
