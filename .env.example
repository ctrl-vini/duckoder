# Copy to .env and fill in what this machine needs; .env is never committed.
# Every setting is listed in the README's Configuration section.

# Which service generates the code: anthropic (the Claude API) or ollama (a model on this machine).
APP_LLM_PROVIDER=anthropic

# Read only by the anthropic provider, which does not start without the key. Keep this file
# readable by its owner alone: chmod 600 .env
APP_ANTHROPIC_API_KEY=
APP_ANTHROPIC_MODEL=claude-sonnet-5-5

# Read only by the ollama provider.
APP_OLLAMA_URL=http://localhost:11434
APP_OLLAMA_MODEL=qwen2.5-coder:7b

# Replies the server generates per hour, across every visitor; 0 turns the cap off.
APP_MAX_REQUESTS_PER_HOUR=60

# With the ollama provider in Docker, start the model alongside the server.
# COMPOSE_PROFILES=local-model
